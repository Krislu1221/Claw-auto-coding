{
  "name": "auto-coding-v3",
  "version": "3.7.9",
  "description": "智能自主编码系统 v3.7 — 全子代理架构 + 分阶段技能注入。支持 8 步循环、Reviewer 否决权、复杂度自动分级、Risk Scorecard 量化检测",
  "author": "Kris Lu",
  "license": "MIT",
  "triggers": [
    "/auto-coding",
    "auto-coding",
    "自动编码",
    "自主编码"
  ],
  "keywords": [
    "auto-coding",
    "agentic-coding",
    "ai-coding",
    "tdd",
    "code-review",
    "risk-scorecard",
    "skill-injection"
  ],
  "main": "__init__.py",
  "files": [
    "__init__.py",
    "workflow_enhanced.py",
    "auto_coding_workflow.py",
    "state_manager.py",
    "model_selector.py",
    "model_auto_router.py",
    "task_profiler.py",
    "scorecard_engine.py",
    "skill_injector.py",
    "agent_soul_loader.py",
    "complexity_analyzer.py",
    "workers/",
    "skills/",
    "configs/",
    "SKILL.md",
    "SECURITY.md",
    "README.md",
    "clawhub.json"
  ],
  "scripts": {
    "test": "python3 -c \"import workflow_enhanced; print('✅ modules loaded')\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Krislu1221/Claw-auto-coding"
  },
  "homepage": "https://clawhub.ai/krislu1221/auto-coding-correctversion",
  "security": {
    "subagent_isolation": "isolated sessions via sessions_spawn",
    "model_constraint": "volcengine-plan provider only",
    "expr_eval": "AST whitelist (no eval/exec)",
    "shell_access": "subprocess for openclaw CLI only, inputs sanitized",
    "third_party_services": "none",
    "local_only": true
  },
  "data_privacy": {
    "data_leaves_device": false,
    "feishu_notifications": "task status only, optional (env: AUTO_CODING_FEISHU_TO)",
    "code_data_sent_to_third_party": "none",
    "note": "All work happens locally via OpenClaw Gateway"
  }
}
